clc; clear; close all;
%% Inputs
load(fullfile('data', 'data.mat'));
mu = G*Ms; % Gravitational for space craft
muE = G*(Ms + Me); % Gravitational parameter for Earth
muC = G*(Ms + Mc); % Gravitational parameter for Ceres

initialDate = datetime(2007, 9, 1, 10, 12, 28); % Yr, Mon, Day, Hr, Min, Sec
days = linspace(100, 365)
days_f = 84; % Final flight time
nf = 1e4; % Number of flight time divisions

%% Main calculations
% Initial and final positions
[Rearth0, Vearth0] = propagate(earth, initialDate, mu);
Rearth0 = Rearth0*ones([1,nf]); Vearth0 = Vearth0*ones([1,nf]);

% Final date
flightTime = linspace(duration(days_i,0,0), duration(days_f,0,0), nf);
finalDate = initialDate + flightTime;

% Earth and ceres positions
[Rceres1, Vceres1] = propagate(ceres, finalDate, mu);
[Rearth1, ~] = propagate(earth, finalDate, mu);

% Spacecraft orbital elements
[V1, V2] = lambert(Rearth0, Rceres1, flightTime, mu);
mask3 = repmat(vecnorm(V1-Vearth0)<vecnorm(V2-Vearth0), 3, 1);
Vi = V1 .* mask3 + V2 .* ~mask3;
DV = vecnorm(Vi-Vearth0);

% Figure
plot(hours(flightTime)/(24*365), DV);
grid minor;
xlabel("Time (anos)", Interpreter='latex', FontSize=17);
ylabel("DV (km/s)", Interpreter='latex', FontSize=17);

%% PLot minimum orbit

% Spacecraft
[~, idx] = min(DV);
spacecraft = getElements(Rearth0(:,idx), Vi(:,idx), initialDate, mu);
spacecraft.name = "Spacecraft";

% Figure
fig = plotOrbit([earth, ceres, spacecraft], initialDate, finalDate(idx), ...
    200, mu);
figure(fig); hold on; view(-7, 20.5); fig.Position = [532 226 903 620];
